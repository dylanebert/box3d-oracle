{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "box3d-oracle/scenario-command/v1",
  "title": "Box3D scenario command corpus",
  "type": "object",
  "required": ["schema", "corpusVersion", "scenarios"],
  "properties": {
    "schema": { "const": "box3d-oracle/scenario-command/v1" },
    "corpusVersion": { "const": 1 },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "commands", "stepCount"],
        "properties": {
          "id": { "pattern": "^s1\\.[a-z0-9-]+\\.v1$" },
          "name": { "type": "string" },
          "stepCount": { "type": "integer", "minimum": 1 },
          "commands": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["op", "id"],
              "properties": {
                "op": { "enum": ["world.create", "body.create", "body.spawn", "body.apply-mass", "body.set-velocity", "body.target-transform", "resource.box", "resource.sphere", "resource.capsule", "resource.hull", "resource.mesh", "resource.height-field", "resource.compound", "shape.create", "sensor.events", "joint.filter", "joint.revolute", "joint.weld", "joint.parallel", "joint.motor", "joint.distance", "joint.prismatic", "joint.spherical", "joint.wheel", "step", "observe", "hash"] },
                "id": { "type": "string" }
              },
              "additionalProperties": true
            }
          },
          "requiredJointIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
          "requiredSensorEventIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": false
}
